{
  "name": "dsh-plugin-context-studio",
  "version": "1.0.0",
  "description": "Context Studio for DeepSeek Harness: see every project's instructions, skills, sessions and memories as puzzle pieces, flag stale ones, remove them with undo, transplant pieces across projects, and compose a starting context for a new session. · DSH 上下文拼图台：看见、清理、跨项目拼接 memory 与 context，一键拼成起始上下文开新会话。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h958661134/dsh-plugin-context-studio.git"
  },
  "homepage": "https://github.com/h958661134/dsh-plugin-context-studio#readme",
  "bugs": {
    "url": "https://github.com/h958661134/dsh-plugin-context-studio/issues"
  },
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./host": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis-plugin",
    "context",
    "memory",
    "agents-md",
    "prompt"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.0 <0.3.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
