{
  "name": "dsh-plugin-context-studio",
  "version": "1.2.0",
  "description": "Context Studio for DeepSeek Harness: inspect historical context behind an answer, investigate source and tool issues, and reuse selected evidence in a new session. · DSH 上下文工作台：追溯回答前的上下文、核对问题线索、挑选片段开新会话；支持记忆清理与跨项目复用。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h958661134/dsh-plugin-context-studio.git"
  },
  "homepage": "https://github.com/h958661134/dsh-plugin-context-studio#readme",
  "bugs": {
    "url": "https://github.com/h958661134/dsh-plugin-context-studio/issues"
  },
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./host": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis-plugin",
    "context",
    "memory",
    "agents-md",
    "prompt"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.0 <0.3.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
